{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "heatmap", "name": "Heatmap", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts", "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true, "expr": "increase(markov_rl_cascade_events_total[1m]) > 0",
        "hide": false, "iconColor": "red", "name": "Cascade Events",
        "step": "60s", "titleFormat": "Cascade Failure", "textFormat": "service={{ $labels.service }}"
      }
    ]
  },
  "description": "Comprehensive monitoring for the Markov-RL Intelligent API Caching System. Covers cache performance, RL agent training, Markov chain predictor, cascade prevention, prefetch efficiency and infrastructure health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1, "title": "🎯 Executive Summary", "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 50 },
            { "color": "yellow", "value": 65 },
            { "color": "green", "value": 75 }
          ]},
          "unit": "percent",
          "min": 0, "max": 100
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 10,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "9.5.0",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_cache_hit_rate{service=\"$service\"} * 100", "legendFormat": "Hit Rate", "refId": "A" }],
      "title": "Cache Hit Rate",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.4 },
            { "color": "orange", "value": 0.6 },
            { "color": "red", "value": 0.85 }
          ]},
          "unit": "percentunit",
          "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 11,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_cascade_risk_score{service=\"$service\"}", "legendFormat": "Risk", "refId": "A" }],
      "title": "Cascade Risk",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null }
          ]},
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 12,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_rl_episode_reward_mean{service=\"$service\"}", "legendFormat": "Reward", "refId": "A" }],
      "title": "Mean Episode Reward (last 100)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.3 },
            { "color": "green", "value": 0.6 }
          ]},
          "unit": "percentunit", "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 13,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_markov_accuracy_topk{service=\"$service\",k=\"1\"}", "legendFormat": "Top-1 Acc", "refId": "A" }],
      "title": "Markov Top-1 Accuracy",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.8 }
          ]},
          "unit": "percentunit", "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 14,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_cascade_prevention_rate{service=\"$service\"}", "legendFormat": "Prevention Rate", "refId": "A" }],
      "title": "Cascade Prevention Rate",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "orange", "value": 0.75 },
            { "color": "red", "value": 0.9 }
          ]},
          "unit": "percentunit", "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 15,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_cache_utilization{service=\"$service\"}", "legendFormat": "Utilisation", "refId": "A" }],
      "title": "Cache Utilisation",
      "type": "stat"
    },


    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 20, "title": "📦 Cache Performance", "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Hit Rate" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Target (70%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2CC0C", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [8, 5], "fill": "dash" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 21,
      "options": { "tooltip": { "mode": "multi", "sort": "none" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_cache_hit_rate{service=\"$service\"}", "legendFormat": "Hit Rate", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "0.70", "legendFormat": "Target (70%)", "refId": "B" }
      ],
      "title": "Cache Hit Rate Over Time",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 22,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_cache_hits_total{service=\"$service\"}[1m])", "legendFormat": "Hits/s – {{ endpoint }}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_cache_misses_total{service=\"$service\"}[1m])", "legendFormat": "Misses/s – {{ endpoint }}", "refId": "B" }
      ],
      "title": "Cache Hits vs Misses Rate (per endpoint)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Utilisation" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "max", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "Entries" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 23,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_cache_entries{service=\"$service\"}", "legendFormat": "Entries", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_cache_utilization{service=\"$service\"}", "legendFormat": "Utilisation", "refId": "B" }
      ],
      "title": "Cache Entries & Utilisation",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 24,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_cache_evictions_total{service=\"$service\"}[1m])", "legendFormat": "Evictions/s ({{ strategy }})", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_cache_sets_total{service=\"$service\"}[1m])", "legendFormat": "Sets/s", "refId": "B" }
      ],
      "title": "Evictions & Set Operations Rate",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 25,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, rate(markov_rl_cache_operation_latency_seconds_bucket{service=\"$service\"}[5m]))", "legendFormat": "p50 – {{ operation }}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, rate(markov_rl_cache_operation_latency_seconds_bucket{service=\"$service\"}[5m]))", "legendFormat": "p95 – {{ operation }}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, rate(markov_rl_cache_operation_latency_seconds_bucket{service=\"$service\"}[5m]))", "legendFormat": "p99 – {{ operation }}", "refId": "C" }
      ],
      "title": "Cache Operation Latency (p50 / p95 / p99)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 26,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, rate(markov_rl_cache_entry_size_bytes_bucket{service=\"$service\"}[5m]))", "legendFormat": "Median entry size", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, rate(markov_rl_cache_entry_size_bytes_bucket{service=\"$service\"}[5m]))", "legendFormat": "p95 entry size", "refId": "B" }
      ],
      "title": "Cache Entry Size Distribution",
      "type": "timeseries"
    },


    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 30, "title": "⚡ Prefetch Engine", "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 31,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_prefetch_efficiency{service=\"$service\"}", "legendFormat": "Efficiency (used/requested)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "0.50", "legendFormat": "Target (50%)", "refId": "B" }
      ],
      "title": "Prefetch Efficiency",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 32,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_prefetch_requests_total{service=\"$service\"}[1m])", "legendFormat": "Requests/s ({{ strategy }})", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_prefetch_hits_total{service=\"$service\"}[1m])", "legendFormat": "Hits/s ({{ strategy }})", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_prefetch_wasted_total{service=\"$service\"}[1m])", "legendFormat": "Wasted/s ({{ strategy }})", "refId": "C" }
      ],
      "title": "Prefetch Rate by Strategy",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "Bps",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 39 },
      "id": 33,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_prefetch_bandwidth_bytes_total{service=\"$service\"}[1m])", "legendFormat": "Prefetch bandwidth", "refId": "A" }
      ],
      "title": "Prefetch Bandwidth Usage",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.30 }, { "color": "green", "value": 0.60 }
          ]}
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 39 },
      "id": 34,
      "options": { "minVizWidth": 75, "minVizHeight": 75, "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_prefetch_efficiency{service=\"$service\"}", "legendFormat": "Efficiency", "refId": "A" }
      ],
      "title": "Prefetch Efficiency Gauge",
      "type": "gauge"
    },


    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "id": 40, "title": "🔗 Markov Chain Predictor", "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "id": 41,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_markov_accuracy_topk{service=\"$service\",k=\"1\"}", "legendFormat": "Top-1 Accuracy", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_markov_accuracy_topk{service=\"$service\",k=\"3\"}", "legendFormat": "Top-3 Accuracy", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_markov_accuracy_topk{service=\"$service\",k=\"5\"}", "legendFormat": "Top-5 Accuracy", "refId": "C" }
      ],
      "title": "Markov Predictor Accuracy (Top-k)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "id": 42,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_markov_predictions_total{service=\"$service\"}[1m])", "legendFormat": "Predictions/s (order={{ order }})", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_markov_vocab_size{service=\"$service\"}", "legendFormat": "Vocab size", "refId": "B" }
      ],
      "title": "Prediction Rate & Vocabulary Size",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "none",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "id": 43,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "markov_rl_markov_transition_entropy{service=\"$service\"}", "legendFormat": "Transition entropy (nats)", "refId": "A" }
      ],
      "title": "Markov Transition Entropy",
      "description": "Shannon entropy of the transition distribution from the current state. High entropy = unpredictable next API. Low entropy = strong predictive signal.",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "id": 44,
      "options": {
        "fillOpacity": 50,
        "tooltip": { "mode": "multi" },
        "yAxis": { "unit": "percentunit" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(markov_rl_markov_confidence_bucket{service=\"$service\"}[5m])", "legendFormat": "{{ le }}", "refId": "A", "format": "heatmap" }
      ],
      "title": "Prediction Confidence Distribution",
      "description": "Heatmap of top-1 prediction confidence over time. Ideal: mass concentrated at 0.7–1.0.",
