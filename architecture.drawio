    <mxCell id="iam" value="AWS IAM&lt;br/&gt;&lt;font color=&apos;#555&apos; style=&apos;font-size:8px&apos;&gt;ECS task execution role&lt;br/&gt;S3 r/w + CW logs:write&lt;br/&gt;ElastiCache connect&lt;/font&gt;" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.role;labelBackgroundColor=#ffffff;sketch=0;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
