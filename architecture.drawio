    <mxCell id="sar_box" value="&lt;b&gt;RL Loop (inside ECS task)&lt;/b&gt;&lt;br/&gt;&lt;font color=&apos;#555&apos; style=&apos;font-size:8px&apos;&gt;1. MarkovPredictor.observe(api_call) -&gt; predict(k=5) -&gt; 60-dim state vector&lt;br/&gt;2. DQNAgent.select_action(state) [e-greedy, e:1.0-&gt;0.05]   3. CacheManager.execute(action) [7 types]&lt;br/&gt;4. RewardCalculator: hit+10 / miss-1 / cascade_prevented+50 / cascade-100&lt;br/&gt;5. agent.store_transition() -&gt; train_step() [batch=64, lr=1e-3, gamma=0.99] -&gt; checkpoint to S3 every 500 ep&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF8F00;fontSize=9;align=left;" vertex="1" parent="1">
      <mxGeometry x="110" y="1050" width="980" height="80" as="geometry"/>
    </mxCell>
