    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- RL TRAINING LOOP ANNOTATION (right side)                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <mxCell id="rl_loop_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FF8F00;arcSize=6;dashed=1;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="2060" y="270" width="400" height="680" as="geometry" />
    </mxCell>
    <mxCell id="rl_loop_title" value="🔄  RL TRAINING LOOP" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#7B3900;" vertex="1" parent="1">
      <mxGeometry x="2060" y="278" width="400" height="25" as="geometry" />
    </mxCell>
    <mxCell id="step1" value="1  obs, _ = env.reset()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FF8F00;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="315" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step2" value="2  action = agent.select_action(obs)  [ε-greedy]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FF8F00;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="360" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step3" value="3  MarkovPredictor.observe(api)  →  predict(k=5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="405" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step4" value="4  StateBuilder.build_state()  → 60-dim obs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="450" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step5" value="5  CacheManager.execute(action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="495" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step6" value="6  RewardCalculator.calculate(outcome)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FF8F00;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="540" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step7" value="7  agent.store_transition(s,a,r,s',done)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FF8F00;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="585" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step8" value="8  if buffer.is_ready: agent.train_step()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FF8F00;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="630" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step9" value="9  agent.decay_epsilon()  [1.0 → 0.05]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#FF8F00;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="675" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step10" value="10  MetricsCollector.record_*()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4CAF50;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="720" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step11" value="11  if done: Trainer.checkpoint()  [every 500 ep]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="765" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step12" value="12  if eval_freq: Trainer.evaluate()  [every 100 ep]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="810" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step13" value="13  if no improvement for 50 ep → early stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="855" width="360" height="32" as="geometry" />
    </mxCell>
    <mxCell id="step14" value="→  repeat for 1000+ episodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF8F00;strokeColor=#E65100;fontSize=11;fontStyle=1;fontColor=white;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="2080" y="900" width="360" height="35" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- REWARD DESIGN CALLOUT                                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <mxCell id="reward_callout" value="&lt;b&gt;🎯  REWARD DESIGN RATIONALE&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;cascade_occurred = -100&lt;/b&gt;  (10× worse than miss)&lt;br/&gt;&lt;b&gt;cascade_prevented = +50&lt;/b&gt;  (5× better than hit)&lt;br/&gt;&lt;b&gt;cache_hit = +10&lt;/b&gt;  (baseline &amp;apos;good&amp;apos; signal)&lt;br/&gt;&lt;b&gt;cache_miss = -1&lt;/b&gt;  (small — misses are normal)&lt;br/&gt;&lt;b&gt;prefetch_used = +5&lt;/b&gt;  (half a hit)&lt;br/&gt;&lt;b&gt;prefetch_wasted = -3&lt;/b&gt;  (not catastrophic)&lt;br/&gt;&lt;br/&gt;Clipped to [-100, +100] for training stability" style="callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;arcSize=4;" vertex="1" parent="1">
      <mxGeometry x="2500" y="830" width="340" height="185" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- STATE VECTOR CALLOUT                                            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <mxCell id="state_callout" value="&lt;b&gt;📐  60-DIM STATE VECTOR BREAKDOWN&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;[0-4]   Markov top-5 API indices (normalised)&lt;br/&gt;[5-9]   Markov top-5 probabilities&lt;br/&gt;[10]    Prediction confidence&lt;br/&gt;[11-14] Cache: util · hit_rate · entries · evict_rate&lt;br/&gt;[15-23] System: cpu · mem · rps · p50/p95/p99&lt;br/&gt;          err_rate · connections · queue_depth&lt;br/&gt;[24-26] User: is_guest · is_free · is_premium&lt;br/&gt;[27-32] Temporal: hour_sin · hour_cos · day_sin&lt;br/&gt;          day_cos · is_weekend · is_peak_hour&lt;br/&gt;[33-35] Session: position · duration · call_count" style="callout;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#FF8F00;fontSize=9;align=left;arcSize=4;" vertex="1" parent="1">
      <mxGeometry x="2500" y="500" width="360" height="240" as="geometry" />
    </mxCell>

