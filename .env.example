# Environment variable examples for markov-rl-api-cache
# Copy to .env and customize

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API / gateway
API_HOST=0.0.0.0
API_PORT=8000

# Monitoring
PROMETHEUS_PORT=8001

# Gateway / Reverse Proxy
UPSTREAM_URL=http://localhost:9000
CACHE_DEFAULT_TTL=300
GATEWAY_PORT=8000
CACHE_ENABLED=true
UPSTREAM_TIMEOUT_MS=5000


# Scheduler
SCHEDULER_ENABLED=true
MARKOV_UPDATE_INTERVAL_SECONDS=300
DQN_TRAIN_INTERVAL_SECONDS=900
EVAL_INTERVAL_SECONDS=3600
CLEANUP_CRON_HOUR=2
CLEANUP_CRON_MINUTE=0

# Training
TRAINING_STEPS_PER_CYCLE=100
MIN_EXPERIENCES_FOR_TRAINING=500
MAX_CHECKPOINTS=10
PERFORMANCE_DEGRADATION_THRESHOLD=0.15
AUTO_ROLLBACK=false

# Data Retention
LOG_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=14

# Resource Guards
MAX_CPU_FOR_TRAINING=80
MAX_MEMORY_FOR_TRAINING=85

# Collector
COLLECTOR_BUFFER_SIZE=10000
COLLECTOR_FLUSH_INTERVAL_SECONDS=60
SESSION_TTL_MINUTES=30
SESSION_MAX_CALLS=200
